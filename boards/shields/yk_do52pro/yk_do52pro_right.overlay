#include "yk_do52pro.dtsi"


&default_transform0 {
    col-offset = <6>;
};


&kscan0 {
    col-gpios
        = <&pro_micro 6 GPIO_ACTIVE_HIGH>
        , <&pro_micro 5 GPIO_ACTIVE_HIGH>
        , <&pro_micro 4 GPIO_ACTIVE_HIGH>
        , <&pro_micro 2 GPIO_ACTIVE_HIGH>
        , <&pro_micro 0 GPIO_ACTIVE_HIGH>
        , <&pro_micro 1 GPIO_ACTIVE_HIGH>
        ;
};


// #if defined(CONFIG_ZMK_SPLIT_ROLE_CENTRAL)
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include "include/mouse_ps2_right.dtsi"

#include <input/processors/report_rate_limit.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
    input_processors {
        disable_event: my_rotation_event_transform {
            compatible = "zmk,input-processor-transform";
            #input-processor-cells = <1>;
            type = <INPUT_EV_REL>;
            x-codes = <INPUT_REL_RX>;
            y-codes = <INPUT_REL_RY>;
        };
    };

    trackpoint_listener: trackpoint_listener {
        compatible = "zmk,input-listener";
        device = <&mouse_ps2>;
        input-processors = <&zip_report_rate_limit 500>,<&zip_xy_scaler 0 1>;
        scroller {
            layers = <10>;
            //process-next;
            input-processors = <&zip_report_rate_limit 16>,<&zip_xy_transform (INPUT_TRANSFORM_XY_SWAP |INPUT_TRANSFORM_X_INVERT)>,<&zip_xy_to_scroll_mapper>;
        };
        mouse {
            layers = <9>;
            input-processors = 
               <&zip_report_rate_limit 16>,<&zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>
                //, <&zip_temp_layer 9 500>
                ;
        };
        game_mouse {
            layers = <2>;
            input-processors = 
                <&zip_report_rate_limit 16>,<&zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>
                //, <&zip_temp_layer 9 500>
                ;
        };
};
};
// #else
// // We have the trackpoint on the right peripheral split, so
// // set the actual trackpoint as the device for the peripheral. 
// &tpoint_split { 
//     device = <&mouse_ps2>; 
//     input-processors = <&zip_xy_swap_mapper>,<&zip_report_rate_limit 24>;
// };

// #endif

